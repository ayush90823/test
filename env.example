# https://my.telegram.org se milega
API_ID=1234567
API_HASH=your_api_hash

# @BotFather se milega
BOT_TOKEN=123456:ABC-your-bot-token

# Private channel ID jisme bot admin ho (-100 se shuru hota hai)
BIN_CHANNEL=-1001234567890

# GitHub Pages player ka fixed URL (workflow me ye khud set ho jata hai)
PLAYER_URL=https://yourusername.github.io/your-repo/

# Koi bhi lamba random string (links secure karne ke liye)
SECRET_KEY=change-me-to-a-long-random-string

PORT=8080

# Optional: sirf in Telegram user IDs ko allow karna (comma separated). Khali = sab
ALLOWED_USERS=
